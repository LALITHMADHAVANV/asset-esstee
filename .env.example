# Local development: mongodb://localhost:27017/
# Vercel: use the Atlas Drivers connection string; URL-encode the credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
# Tenant database names come from the companies registry, not MONGODB_DB_NAME.
REGISTRY_DB_NAME=compliance_master
# Required: generate a private random value of at least 32 characters.
JWT_SECRET=
